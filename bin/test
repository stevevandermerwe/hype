#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Homebrew puts libwebp under /opt/homebrew, outside the default linker search
# path. Expose its headers and libraries when present (macOS).
if [ -d /opt/homebrew/lib ] && [ -d /opt/homebrew/include ]; then
    export LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}/opt/homebrew/lib"
    export CPATH="${CPATH:+$CPATH:}/opt/homebrew/include"
fi
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
"${QMAKE:-qmake6}" "$ROOT/tests/tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=generic QT_STYLE_OVERRIDE=Fusion ./hype-tests "$@"
